class Solution {
public:
    vector<vector<int>> countFrequencies(vector<int>& nums) {
    vector<vector<int>> ans;
    int n =nums.size();
    int hash[100] ={0};
for(int i=0;i<n;i++){
       hash[nums[i]] +=1;
    }
    for(int i=1;i<100;i++){
        if(hash[i]>0){
            ans.push_back({i,hash[i]});
        }
    }
    return ans;

    }
};
