class Solution {
public:
    int mostFrequentElement(vector<int>& nums) {
             int hash[101]={0};
             int n=nums.size();
             for(int i=0;i<n;i++){
                hash[nums[i]]+=1;

             }
             int maxfreq=0;
             int ans =-1;
             for(int i=0;i<=100;i++){
                   if(hash[i]>maxfreq){
                    maxfreq = hash[i];
                    ans =i;
                   }
                   
             }
             return ans;
    }
};
