class Solution{	
	public:		
		bool palindromeCheck(string& s){
			//your code goes here
            int start =0;
            int end = s.length()-1;
            while(start <= end){
                if(s[start]!=s[end]){
                    return 0;
                }
                
                start++;
                end--;
            }
            return true;
		}
};
