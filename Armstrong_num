class Solution {
public:
    bool isArmstrong(int n) {
      int sum =0 , count =0 ;
      int org = n;
      int temp =n;
      while(temp >0){
        count++;
        temp =temp/10;
      }
      while( n> 0){
        int d = n % 10;
        sum+=pow(d,count);
        n=n/10;
      }
      return org == sum;
    }
};
